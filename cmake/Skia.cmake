file(READ "${CMAKE_CURRENT_LIST_DIR}/../dependencies/skia.json" _skia_lock)
string(JSON _skia_revision GET "${_skia_lock}" revision)
if(NOT EXISTS "${SKIA_LIBRARY_DIR}/skia-window-build.json")
  message(FATAL_ERROR "Skia is not bootstrapped for ${SKIA_WINDOW_ARCH}/${CMAKE_BUILD_TYPE}.\nRun: python3 scripts/bootstrap_skia.py --arch ${SKIA_WINDOW_ARCH} --config ${CMAKE_BUILD_TYPE}")
endif()
file(READ "${SKIA_LIBRARY_DIR}/skia-window-build.json" _skia_build)
foreach(_field IN ITEMS revision arch config deployment_target)
  string(JSON _skia_${_field} GET "${_skia_build}" "${_field}")
endforeach()
string(JSON _locked_revision GET "${_skia_lock}" revision)
if(NOT _skia_revision STREQUAL _locked_revision OR NOT _skia_arch STREQUAL SKIA_WINDOW_ARCH
   OR NOT _skia_config STREQUAL CMAKE_BUILD_TYPE
   OR NOT _skia_deployment_target VERSION_EQUAL CMAKE_OSX_DEPLOYMENT_TARGET)
  message(FATAL_ERROR "Skia revision, architecture, configuration or deployment target does not match. Rerun bootstrap.")
endif()
add_library(skia_window_skia INTERFACE)
target_include_directories(skia_window_skia SYSTEM INTERFACE "${SKIA_SOURCE_DIR}")
target_compile_definitions(skia_window_skia INTERFACE SK_GANESH SK_METAL SK_DISABLE_TRACING SK_GAMMA_APPLY_TO_A8)
foreach(_lib IN ITEMS skia skcms png zlib)
  if(NOT EXISTS "${SKIA_LIBRARY_DIR}/lib${_lib}.a")
    message(FATAL_ERROR "Missing ${SKIA_LIBRARY_DIR}/lib${_lib}.a; rerun bootstrap.")
  endif()
  target_link_libraries(skia_window_skia INTERFACE "${SKIA_LIBRARY_DIR}/lib${_lib}.a")
endforeach()
foreach(_framework IN ITEMS AppKit Metal QuartzCore CoreGraphics CoreText CoreFoundation Foundation IOSurface)
  find_library(_path_${_framework} ${_framework} REQUIRED)
  target_link_libraries(skia_window_skia INTERFACE "${_path_${_framework}}")
endforeach()
